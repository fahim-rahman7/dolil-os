generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  WRITER
  ASSISTANT
  ACCOUNTANT
}

enum DeedStatus {
  DRAFT
  REVIEW
  READY
  PRINTED
  DELIVERED
  CANCELLED
}

enum PartyRole {
  BUYER
  SELLER
  DONOR
  RECIPIENT
  WITNESS
  REPRESENTATIVE
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE
}

enum PaymentType {
  PAYMENT
  REVERSAL
}

enum ApprovalStatus {
  UNAPPROVED
  APPROVED
}

enum FeeKind {
  OFFICE
  STATUTORY
}

enum FeeBasis {
  FIXED
  PERCENT_OF_VALUE
  PER_AREA_UNIT
}

enum ValuationBasis {
  TOTAL
  PER_UNIT
}

enum DocOwner {
  CUSTOMER
  LAND
  DEED
}

model Office {
  id                     String   @id @default(cuid())
  name                   String
  phone                  String?
  email                  String?
  address                String?  @db.Text
  autoNumbering          Boolean  @default(false)
  numberPrefix           String   @default("DOL")
  nextNumber             Int      @default(1)
  allowGenericDraft      Boolean  @default(true)
  adminCanManageSettings Boolean  @default(false)
  adminCanManageUsers    Boolean  @default(false)
  printPageSize          String   @default("A4")
  printMarginMm          Int      @default(20)
  printFont              String   @default("Noto Sans Bengali")
  printHeader            String?  @db.Text
  printFooter            String?  @db.Text
  areaConversions        Json
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users     User[]
  customers Customer[]
  lands     Land[]
  deeds     Deed[]
  payments  Payment[]
  templates DeedTemplate[]
  feeRates  FeeRate[]
  documents Document[]
  audits    AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  officeId     String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(WRITER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  office    Office    @relation(fields: [officeId], references: [id])
  deeds     Deed[]
  payments  Payment[]
  documents Document[]

  @@index([officeId])
}

model Customer {
  id         String   @id @default(cuid())
  officeId   String
  name       String
  phone      String?
  email      String?
  nid        String?
  fatherName String?
  motherName String?
  husbandName      String?
  birthDate        DateTime? @db.Date
  religion         String?
  profession       String?
  nationality      String?
  permanentAddress String?   @db.Text
  address    String?  @db.Text
  notes      String?  @db.Text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  office      Office      @relation(fields: [officeId], references: [id])
  deedParties DeedParty[]

  @@unique([officeId, nid])
  @@index([officeId, name])
  @@index([officeId, phone])
}

model Land {
  id               String   @id @default(cuid())
  officeId         String
  district         String
  upazila          String
  mouza            String
  jlNumber         String?
  union            String?
  landOffice       String?
  holdingNo        String?
  khatianNumber    String?
  khatianType      String?
  dagNumber        String
  area             Decimal  @db.Decimal(12, 4)
  areaUnit         String   @default("decimal")
  classification   String?
  ownershipDetails String?  @db.Text
  boundaryNorth    String?
  boundarySouth    String?
  boundaryEast     String?
  boundaryWest     String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  office    Office     @relation(fields: [officeId], references: [id])
  deedLands DeedLand[]

  @@index([officeId, mouza, dagNumber])
  @@index([officeId, district])
}

model DeedTemplate {
  id             String         @id @default(cuid())
  officeId       String
  deedType       String
  version        Int
  name           String
  body           String         @db.Text
  approvalStatus ApprovalStatus @default(UNAPPROVED)
  approvedById   String?
  approvedAt     DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())

  office Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, deedType, version])
  @@index([officeId, deedType, approvalStatus])
}

model FeeRate {
  id             String    @id @default(cuid())
  officeId       String
  label          String
  kind           FeeKind
  basis          FeeBasis
  rate           Decimal   @db.Decimal(14, 4)
  effectiveFrom  DateTime
  source         String
  verified       Boolean   @default(false)
  approvedBy     String?
  lastVerifiedAt DateTime?
  active         Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, label, effectiveFrom])
}

model Deed {
  id              String         @id @default(cuid())
  officeId        String
  deedNumber      String?
  title           String
  deedType        String
  status          DeedStatus     @default(DRAFT)
  executionDate   DateTime?
  valuationBasis  ValuationBasis @default(TOTAL)
  perUnitRate     Decimal?       @db.Decimal(14, 2)
  landValue       Decimal        @default(0) @db.Decimal(14, 2)
  totalArea       Decimal        @default(0) @db.Decimal(12, 4)
  areaUnit        String         @default("decimal")
  agreedFee       Decimal?       @db.Decimal(14, 2)
  calculatedFees  Decimal        @default(0) @db.Decimal(14, 2)
  feeLines        Json?
  content         Json
  snapshot        Json?
  details         Json?
  templateId      String?
  templateVersion Int?
  checklist       Json?
  notes           String?        @db.Text
  cancelReason    String?        @db.Text
  printCount      Int            @default(0)
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String

  office    Office         @relation(fields: [officeId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  parties   DeedParty[]
  lands     DeedLand[]
  payments  Payment[]
  revisions DeedRevision[]

  @@unique([officeId, deedNumber])
  @@index([officeId, status, createdAt])
  @@index([officeId, deedType])
}

model DeedRevision {
  id         String   @id @default(cuid())
  deedId     String
  version    Int
  title      String
  content    Json
  reason     String?  @db.Text
  editedById String
  createdAt  DateTime @default(now())

  deed Deed @relation(fields: [deedId], references: [id], onDelete: Cascade)

  @@index([deedId, version])
}

model DeedParty {
  id         String    @id @default(cuid())
  deedId     String
  customerId String
  role       PartyRole

  deed     Deed     @relation(fields: [deedId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([deedId, customerId, role])
}

model DeedLand {
  id     String   @id @default(cuid())
  deedId String
  landId String
  share  Decimal? @db.Decimal(12, 4)
  value  Decimal? @db.Decimal(14, 2)

  deed Deed @relation(fields: [deedId], references: [id], onDelete: Cascade)
  land Land @relation(fields: [landId], references: [id])

  @@unique([deedId, landId])
}

model Payment {
  id           String        @id @default(cuid())
  officeId     String
  deedId       String
  type         PaymentType   @default(PAYMENT)
  amount       Decimal       @db.Decimal(14, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  receiptNo    String
  paidAt       DateTime      @default(now())
  note         String?       @db.Text
  reversesId   String?       @unique
  receivedById String
  createdAt    DateTime      @default(now())

  office     Office  @relation(fields: [officeId], references: [id])
  deed       Deed    @relation(fields: [deedId], references: [id])
  receivedBy User    @relation(fields: [receivedById], references: [id])
  reverses   Payment? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy Payment? @relation("Reversal")

  @@unique([officeId, receiptNo])
  @@index([officeId, paidAt])
  @@index([deedId])
}

model Document {
  id           String   @id @default(cuid())
  officeId     String
  ownerType    DocOwner
  ownerId      String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  office     Office @relation(fields: [officeId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([officeId, ownerType, ownerId])
}

model AuditLog {
  id            String   @id @default(cuid())
  officeId      String?
  userId        String?
  action        String
  entity        String
  entityId      String?
  reason        String?  @db.Text
  meta          Json?
  correlationId String?
  createdAt     DateTime @default(now())

  office Office? @relation(fields: [officeId], references: [id])

  @@index([officeId, entity, entityId])
  @@index([officeId, createdAt])
}
